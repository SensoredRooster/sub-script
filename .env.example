# Copy to .env — never commit real secrets
# Path to Google OAuth Desktop client JSON (also youtube.client_secrets_file in config.yaml)
YOUTUBE_CLIENT_SECRETS=credentials.json
# Saved automatically after the first Approve login (gitignored)
YOUTUBE_TOKEN=token.json
# Safety switch: set to 1 to force dry-run (no YouTube upload) even if youtube.enabled is true.
# Leave 0 (or delete the line) once you want real uploads. The app prints a notice when forced.
SUB_SCRIPT_DRY_RUN=0
# Set to 1 to stop Approve from popping the out\approved\<id>\ folder open (headless / tests).
SUB_SCRIPT_NO_OPEN=0

# TikTok desktop Content Posting API (keep both values private)
# Copy the client key and secret from your TikTok developer app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Saved automatically after Connect TikTok (gitignored)
TIKTOK_TOKEN=tiktok-token.json
# Must match the redirect URI registered in the TikTok developer portal.
TIKTOK_REDIRECT_URI=http://127.0.0.1:8787/connections/tiktok/callback
